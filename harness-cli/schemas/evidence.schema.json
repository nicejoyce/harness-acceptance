{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "lane", "risk_tier", "harness_version", "run_id", "repository_root", "context", "commit_sha", "ci_provenance", "platform", "node_version", "operation", "target_environment", "changed_files", "route_ids", "contracts_sha256", "plan_path", "plan_sha256", "exceptions_path", "exceptions_sha256", "approvals_path", "approvals_sha256", "rule_attestations_path", "rule_attestations_sha256", "started_at", "ended_at", "gates", "approvals", "result", "manifest_sha256"],
  "properties": {
    "version": { "const": 1 }, "lane": { "enum": ["fast", "full"] }, "risk_tier": { "enum": ["low", "medium", "high", "critical"] }, "harness_version": { "type": "string" }, "run_id": { "type": "string" }, "repository_root": { "type": "string" }, "context": { "type": ["object", "null"], "additionalProperties": false, "required": ["repository", "pull_request", "base_sha", "head_sha"], "properties": { "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }, "pull_request": { "type": "integer", "minimum": 1 }, "base_sha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }, "head_sha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" } } }, "commit_sha": { "type": ["string", "null"] }, "ci_provenance": { "type": ["object", "null"], "additionalProperties": false, "required": ["provider", "repository", "run_id", "run_attempt", "workflow_ref", "event_name"], "properties": { "provider": { "const": "github-actions" }, "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }, "run_id": { "type": "string", "pattern": "^[1-9][0-9]*$" }, "run_attempt": { "type": "integer", "minimum": 1 }, "workflow_ref": { "type": "string", "minLength": 1 }, "event_name": { "type": "string", "minLength": 1 } } }, "platform": { "type": "string" }, "node_version": { "type": "string" },
    "operation": { "enum": ["change", "merge", "release"] }, "target_environment": { "type": "string" }, "changed_files": { "type": "array", "items": { "type": "string" } }, "route_ids": { "type": "array", "items": { "type": "string" } }, "contracts_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "plan_path": { "type": "string", "minLength": 1 }, "plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "exceptions_path": { "type": "string", "minLength": 1 }, "exceptions_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "approvals_path": { "type": "string", "minLength": 1 }, "approvals_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "rule_attestations_path": { "type": "string", "minLength": 1 }, "rule_attestations_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "started_at": { "type": "string" }, "ended_at": { "type": "string" },
    "gates": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["gate_id", "rule_ids", "started_at", "ended_at", "duration_ms", "exit_code", "state"], "properties": { "gate_id": { "type": "string" }, "rule_ids": { "type": "array", "items": { "type": "string" } }, "command_digest": { "type": "string" }, "started_at": { "type": "string" }, "ended_at": { "type": "string" }, "duration_ms": { "type": "number", "minimum": 0 }, "exit_code": { "type": ["integer", "null"] }, "state": { "enum": ["passed", "failed", "timed_out", "cancelled", "exception"] }, "log_path": { "type": "string" }, "log_sha256": { "type": "string" }, "exception_id": { "type": "string" }, "approval_id": { "type": "string" }, "approval_digest": { "type": "string" } } } },
    "approvals": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["role", "approval_ids", "state"], "properties": { "role": { "type": "string" }, "approval_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "state": { "enum": ["passed", "failed"] } } } },
    "result": { "enum": ["passed", "failed"] }, "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

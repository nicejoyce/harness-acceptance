{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "commands", "approvals"],
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "data_classification"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "data_classification": { "enum": ["public", "internal", "confidential", "restricted"] }
      }
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executable", "args", "cwd", "timeout_seconds"],
        "properties": {
          "executable": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "cwd": { "type": "string", "minLength": 1 },
          "execution_root": { "enum": ["project", "trusted-harness"] },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
          "environment": { "type": "object", "additionalProperties": { "type": "string" } },
          "inherited_environment": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "sensitive_environment": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles"],
      "properties": {
        "roles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "routes"],
  "properties": {
    "version": { "enum": [1, 2] },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "include", "rules", "gates", "approvals"],
        "properties": {
          "id": { "type": "string", "pattern": "^route\\.[a-z0-9][a-z0-9.-]*$" },
          "include": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "extends": { "type": "string", "pattern": "^route\\.[a-z0-9][a-z0-9.-]*$" },
          "risk_tier": { "enum": ["low", "medium", "high", "critical"] },
          "fallback": { "type": "boolean" },
          "rules": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "gates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "approvals": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "gates"],
  "properties": {
    "version": { "const": 1 },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "kind", "evidence", "owner", "exception_allowed"],
        "properties": {
          "id": { "type": "string", "pattern": "^gate\\.[a-z0-9][a-z0-9.-]*$" },
          "severity": { "enum": ["BLOCKER", "REQUIRED", "CONDITIONAL"] },
          "kind": { "enum": ["command", "manual-review"] },
          "command": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "exception_allowed": { "type": "boolean" },
          "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "command" } } },
            "then": {
              "properties": { "command": { "type": "string", "minLength": 1 } },
              "required": ["command"]
            }
          },
          { "if": { "properties": { "severity": { "const": "BLOCKER" } } }, "then": { "properties": { "exception_allowed": { "const": false } } } }
        ]
      }
    }
  }
}

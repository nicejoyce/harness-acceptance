{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source_binding", "changed_test_patterns", "test_command", "mutation"],
  "properties": {
    "version": { "const": 1 },
    "source_binding": { "const": "protected-base" },
    "changed_test_patterns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "test_command": {
      "type": "object", "additionalProperties": false, "required": ["executable", "args"],
      "properties": { "executable": { "enum": ["npm", "node"] }, "args": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
    },
    "mutation": {
      "type": "object", "additionalProperties": false, "required": ["tool", "version", "smoke_threshold", "full_schedule"],
      "properties": {
        "tool": { "const": "@stryker-mutator/core" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "smoke_threshold": { "type": "number", "minimum": 0, "maximum": 100 },
        "full_schedule": { "type": "string", "minLength": 1 }
      }
    }
  }
}

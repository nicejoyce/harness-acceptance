{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "policies"],
  "properties": {
    "version": { "const": 1 },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule_ids", "roles", "checklist_version", "required_claims"],
        "properties": {
          "id": { "type": "string", "pattern": "^attestation\\.[a-z0-9][a-z0-9.-]*$" },
          "rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" }, "uniqueItems": true },
          "roles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "checklist_version": { "type": "string", "minLength": 1 },
          "required_claims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  }
}

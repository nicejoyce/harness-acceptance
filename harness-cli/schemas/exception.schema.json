{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "rule_ids", "gate_ids", "scope", "reason", "risk", "compensating_controls", "approver", "approval_reference", "created_at", "review_at", "expires_at", "removal_plan"],
  "properties": {
    "id": { "type": "string", "pattern": "^EX-[A-Za-z0-9.-]+$" },
    "rule_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "gate_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "scope": { "type": "object", "additionalProperties": false, "required": ["paths"], "properties": { "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
    "reason": { "type": "string", "minLength": 1 },
    "risk": { "type": "string", "minLength": 1 },
    "compensating_controls": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "approver": { "type": "string", "minLength": 1 },
    "approval_reference": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "review_at": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "minLength": 1 },
    "removal_plan": { "type": "string", "minLength": 1 }
  }
}

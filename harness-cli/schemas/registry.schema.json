{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "modules", "rules"],
  "properties": {
    "version": { "const": 3 },
    "modules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prefix", "owner"],
        "properties": {
          "prefix": { "type": "string", "pattern": "^[A-Z]+$" },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "module", "severity", "gates", "exception_allowed"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
          "module": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["BLOCKER", "REQUIRED", "CONDITIONAL"] },
          "gates": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "exception_allowed": { "type": "boolean" }
        },
        "allOf": [
          { "if": { "properties": { "severity": { "const": "BLOCKER" } } }, "then": { "properties": { "exception_allowed": { "const": false } } } }
        ]
      }
    }
  }
}

{
  "name": "enterprise-development-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test harness-cli/test/*.test.ts",
    "coverage:test": "c8 --reporter=json --report-dir=coverage npm test",
    "mutation:smoke": "stryker run stryker.config.json",
    "mutation:full": "stryker run stryker.full.config.json",
    "typecheck": "tsc --noEmit",
    "service:typecheck": "tsc -p harness-service/tsconfig.json --noEmit",
    "service:test": "node --test harness-service/test/*.test.ts",
    "harness": "node harness-cli/src/cli.ts"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "minimatch": "10.0.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@types/node": "24.3.0",
    "c8": "10.1.3",
    "typescript": "5.9.2"
  }
}
